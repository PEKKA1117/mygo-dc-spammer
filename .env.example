# ---- Required ----------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# Also switch ON "Message Content Intent" on that page, or auto-reply sees nothing.
DISCORD_TOKEN=

# ---- Engine ------------------------------------------------------------
# mygochat = the real RoBERTa classifier (needs requirements-model.txt + the
#            1.3 GB checkpoint pulled by scripts/setup.sh)
# random   = picks a random quote from Label_Path.json; no torch, no download.
#            Handy for testing permissions and commands first.
MYGO_ENGINE=mygochat

# Where the MyGOChat clone lives. Defaults to ./vendor/MyGOChat.
#MYGOCHAT_PATH=./vendor/MyGOChat

# ---- Optional ----------------------------------------------------------
# Where per-guild settings are persisted.
#SETTINGS_PATH=./data/guilds.json

# Longest message fed to the classifier.
#MAX_INPUT_CHARS=300

# How many candidates to request per prediction.
#CANDIDATE_COUNT=5

# Comma-separated user IDs treated as bot owners.
#OWNER_IDS=

# Sync slash commands to one guild instantly instead of waiting on global
# propagation (which can take up to an hour). Great while developing.
#DEV_GUILD_ID=

#LOG_LEVEL=INFO
